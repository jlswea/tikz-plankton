\define@key{plantree}{type}{\def\plan@treetype{#1}}
\define@key{plantree}{color}{\def\plan@treecolor{#1}}

\newcommand{\plantree}[3][]{%
  \begingroup
  \def\plan@treetype{deciduous}%
  \def\plan@treecolor{plan@sitecolor}%
  \setkeys{plantree}{#1}%
  \def\plan@tmp@coniferous{coniferous}%
  \def\plan@tmp@palm{palm}%
  \ifx\plan@treetype\plan@tmp@coniferous
    \fill[\plan@treecolor, opacity=0.2] (#2) circle (#3);%
    \draw[\plan@treecolor, thick] (#2) circle (#3);%
    \foreach \a in {0,60,120} {%
      \draw[\plan@treecolor, thin]
        ($(#2)+(\a:#3*0.8)$) -- ($(#2)+(\a+180:#3*0.8)$);%
    }%
  \else\ifx\plan@treetype\plan@tmp@palm
    \fill[\plan@treecolor, opacity=0.15] (#2) circle (#3);%
    \draw[\plan@treecolor, thick] (#2) circle (#3);%
    \foreach \a in {0,45,...,315} {%
      \draw[\plan@treecolor, thin]
        ($(#2)+(\a:#3*0.2)$) .. controls ($(#2)+(\a+15:#3*0.6)$) .. ($(#2)+(\a:#3*0.9)$);%
    }%
  \else
    \fill[\plan@treecolor, opacity=0.25] (#2) circle (#3);%
    \draw[\plan@treecolor, thick] (#2) circle (#3);%
    \foreach \a in {0,30,...,330} {%
      \pgfmathsetmacro{\plan@scr}{#3*0.85 + #3*0.15*rnd}%
      \draw[\plan@treecolor, thin]
        ($(#2)+(\a:\plan@scr)$) arc[start angle=\a, end angle=\a+30, radius=\plan@scr];%
    }%
    \fill[\plan@treecolor] (#2) circle (#3*0.1);%
  \fi\fi
  \endgroup
}
