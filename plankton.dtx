% \begin{macro}{\plandimension}
% Draws a dimension line with auto-calculated label.
%    \begin{macrocode}
\define@key{plandim}{offset}{\def\plan@dimoffset{#1}}
\define@key{plandim}{label}{\def\plan@dimlabel{#1}}
\define@key{plandim}{position}{\def\plan@dimpos{#1}}

\newcommand{\plandimension}[3][]{%
  \begingroup
  \def\plan@dimoffset{0.5}%
  \def\plan@dimlabel{}%
  \def\plan@dimpos{above}%
  \setkeys{plandim}{#1}%
  \pgfmathparse{\plan@dimoffset}%
  \ifpgfmathunitsdeclared
    \edef\plan@dimoffsetlen{\pgfmathresult pt}%
  \else
    \edef\plan@dimoffsetlen{\pgfmathresult cm}%
  \fi
  \coordinate (plan@dimA) at ($(#2)!\plan@dimoffsetlen!90:(#3)$);%
  \coordinate (plan@dimB) at ($(#3)!\plan@dimoffsetlen!-90:(#2)$);%
  \draw[thin, gray] (#2) -- (plan@dimA);%
  \draw[thin, gray] (#3) -- (plan@dimB);%
  \ifplan@imperial
    \draw[thin, gray, {Stealth[length=2pt]}-{Stealth[length=2pt]}]
      (plan@dimA) -- (plan@dimB);%
  \else
    \draw[thin, gray] (plan@dimA) -- (plan@dimB);%
    \pgfmathanglebetweenpoints%
      {\pgfpointanchor{plan@dimA}{center}}%
      {\pgfpointanchor{plan@dimB}{center}}%
    \let\plan@dimangle\pgfmathresult
    \begin{scope}[shift={(plan@dimA)}, rotate=\plan@dimangle]
      \draw[thin, gray] (-0.08,-0.08) -- (0.08,0.08);%
    \end{scope}
    \begin{scope}[shift={(plan@dimB)}, rotate=\plan@dimangle]
      \draw[thin, gray] (-0.08,-0.08) -- (0.08,0.08);%
    \end{scope}
  \fi
  \ifx\plan@dimlabel\empty
    \pgfpointdiff{\pgfpointanchor{plan@dimA}{center}}{\pgfpointanchor{plan@dimB}{center}}%
    \pgfmathsetmacro{\plan@dist}{veclen(\pgf@x,\pgf@y)/1cm}%
    \ifplan@imperial
      \pgfmathsetmacro{\plan@totalinches}{\plan@dist * 39.3701}%
      \pgfmathsetmacro{\plan@feet}{int(\plan@totalinches / 12)}%
      \pgfmathsetmacro{\plan@inches}{int(round(\plan@totalinches - \plan@feet * 12))}%
      \node[\plan@dimpos, font=\tiny, gray] at ($(plan@dimA)!0.5!(plan@dimB)$)
        {\plan@feet'-\plan@inches"};%
    \else
      \pgfmathsetmacro{\plan@distmm}{int(round(\plan@dist * 1000))}%
      \node[\plan@dimpos, font=\tiny, gray] at ($(plan@dimA)!0.5!(plan@dimB)$)
        {\plan@distmm};%
    \fi
  \else
    \node[\plan@dimpos, font=\tiny, gray] at ($(plan@dimA)!0.5!(plan@dimB)$) {\plan@dimlabel};%
  \fi
  \endgroup
}
%    \end{macrocode}
% \end{macro}
