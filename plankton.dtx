    \draw[\plan@windowcolor, line width=0.5pt]
      ($(#2)!\plan@woff!90:(#3)$) -- ($(#3)!\plan@woff!-90:(#2)$);%
    \draw[\plan@windowcolor, line width=0.5pt]
      ($(#2)!\plan@woff!-90:(#3)$) -- ($(#3)!\plan@woff!90:(#2)$);%
    \draw[white, line width=\plan@wallthickness] (#2) -- (#3);%
    \draw[\plan@windowcolor, line width=0.5pt] (#2) -- (#3);%
    \draw[\plan@windowcolor, line width=0.5pt]
      ($(#2)!\plan@woff!90:(#3)$) -- ($(#3)!\plan@woff!-90:(#2)$);%
    \draw[\plan@windowcolor, line width=0.5pt]
      ($(#2)!\plan@woff!-90:(#3)$) -- ($(#3)!\plan@woff!90:(#2)$);%
  \else
    \draw[white, line width=\plan@wallthickness] (#2) -- (#3);%
    \draw[\plan@windowcolor, line width=0.8pt] (#2) -- (#3);%
    \pgfmathsetmacro{\plan@ticklen}{0.06}%
    \draw[\plan@windowcolor, line width=0.8pt]
      ($(#2)!\plan@ticklen!90:(#3)$) -- ($(#2)!\plan@ticklen!-90:(#3)$);%
    \draw[\plan@windowcolor, line width=0.8pt]
