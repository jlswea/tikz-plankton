\define@key{planproperty}{color}{\def\plan@propcolor{#1}}
\define@key{planproperty}{label}{\def\plan@proplabel{#1}}

\newcommand{\planproperty}[2][]{%
  \begingroup
  \def\plan@propcolor{black}%
  \def\plan@proplabel{}%
  \setkeys{planproperty}{#1}%
  \draw[\plan@propcolor, thick, dash dot] #2;%
