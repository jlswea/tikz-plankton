%% UTILITIES
%% ============================================================
%
% \begin{macro}{\plansiteutility}
% Utility line with inline type label.
%    \begin{macrocode}
\define@key{plansiteutility}{type}{\def\plan@utiltype{#1}}
\define@key{plansiteutility}{color}{\def\plan@utilcolor{#1}}

\newcommand{\plansiteutility}[2][]{%
  \begingroup
  \def\plan@utiltype{water}%
  \def\plan@utilcolor{}%
  \setkeys{plansiteutility}{#1}%
  \def\plan@tmp@sewer{sewer}%
  \def\plan@tmp@gas{gas}%
  \def\plan@tmp@electric{electric}%
  \ifx\plan@utiltype\plan@tmp@sewer
    \ifx\plan@utilcolor\empty \def\plan@utilcolor{brown!60!black}\fi
    \def\plan@utillabel{S}%
    \def\plan@utildash{dash dot}%
  \else\ifx\plan@utiltype\plan@tmp@gas
    \ifx\plan@utilcolor\empty \def\plan@utilcolor{yellow!70!black}\fi
    \def\plan@utillabel{G}%
    \def\plan@utildash{dashed}%
  \else\ifx\plan@utiltype\plan@tmp@electric
    \ifx\plan@utilcolor\empty \def\plan@utilcolor{red!70!black}\fi
    \def\plan@utillabel{E}%
    \def\plan@utildash{dashed}%
  \else
    \ifx\plan@utilcolor\empty \def\plan@utilcolor{blue!70!black}\fi
    \def\plan@utillabel{W}%
    \def\plan@utildash{dashed}%
  \fi\fi\fi
  \draw[\plan@utilcolor, thick, \plan@utildash,
        postaction={decorate, decoration={markings,
          mark=at position 0.3 with {%
            \node[fill=white, inner sep=1pt, font=\tiny\bfseries, text=\plan@utilcolor]
              {\plan@utillabel};%
          },
          mark=at position 0.7 with {%
            \node[fill=white, inner sep=1pt, font=\tiny\bfseries, text=\plan@utilcolor]
              {\plan@utillabel};%
          }%
        }}]
    #2;%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
