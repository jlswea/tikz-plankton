%    \begin{macrocode}
\define@key{planstairs}{direction}{\def\plan@stairdir{#1}}
\define@key{planstairs}{rotation}{\def\plan@stairrot{#1}}

\newcommand{\planstairs}[5][]{%
  \begingroup
  \def\plan@stairdir{up}%
  \def\plan@stairrot{0}%
  \setkeys{planstairs}{#1}%
  \begin{scope}[shift={(#2)}, rotate=\plan@stairrot]
    \draw[thin] (0,0) rectangle (#3,#4);%
    \pgfmathsetmacro{\plan@stepsize}{#4/#5}%
    \foreach \i in {1,...,#5} {%
      \draw[thin] (0, \i*\plan@stepsize) -- (#3, \i*\plan@stepsize);%
    }%
    \draw[-{Stealth[length=3pt]}, thin]
      (#3/2, 0.1) -- (#3/2, #4-0.1);%
  \end{scope}
  \endgroup
}
