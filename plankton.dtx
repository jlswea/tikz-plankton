%<*base>
% plankton-base.sty — Architectural floor plan elements for TikZ
% Provides: walls, rooms, doors, windows, stairs, dimensions
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{plankton-base}[2024/01/01 Plankton base architectural elements]

\RequirePackage{tikz}
\RequirePackage{xkeyval}

\usetikzlibrary{calc,patterns,decorations.markings,arrows.meta}

%% ============================================================
%% Package options: units = metric (default) | imperial
%% ============================================================
\newif\ifplan@imperial
\plan@imperialfalse

\DeclareOptionX{units}{%
  \def\plan@tmp{#1}%
  \def\plan@opt@metric{metric}%
  \def\plan@opt@imperial{imperial}%
  \ifx\plan@tmp\plan@opt@imperial
    \plan@imperialtrue
  \else
    \plan@imperialfalse
  \fi
}
\ProcessOptionsX\relax

%% ============================================================
%% Configuration
%% ============================================================
\newlength{\plan@wallthickness}
\setlength{\plan@wallthickness}{0.15cm}

\newlength{\plan@doorwidth}
\setlength{\plan@doorwidth}{0.9cm}

\newlength{\plan@windowwidth}
\setlength{\plan@windowwidth}{0.8cm}

%% Scale: 1 unit = 1 meter by default
\newcommand{\plan@scale}{1}

%% ============================================================
%% Wall
%% ============================================================
%    \end{macrocode}
%
% \begin{macro}{\planwall}
% Draws a single wall segment between two points.
%    \begin{macrocode}
\define@key{planwall}{thickness}{\setlength{\plan@wallthickness}{#1}}
\define@key{planwall}{color}{\def\plan@wallcolor{#1}}
\define@key{planwall}{style}{\def\plan@wallstyle{#1}}

\newcommand{\planwall}[3][]{%
  \begingroup
  \def\plan@wallcolor{black}%
  \def\plan@wallstyle{single}%
  \setkeys{planwall}{#1}%
  \def\plan@tmp@double{double}%
  \ifx\plan@wallstyle\plan@tmp@double
    \pgfmathsetmacro{\plan@halfwall}{\plan@wallthickness/2}%
    \draw[\plan@wallcolor, line width=0.4pt]
      ($(#2)!\plan@halfwall pt!90:(#3)$) -- ($(#3)!\plan@halfwall pt!-90:(#2)$);%
    \draw[\plan@wallcolor, line width=0.4pt]
      ($(#2)!\plan@halfwall pt!-90:(#3)$) -- ($(#3)!\plan@halfwall pt!90:(#2)$);%
  \else
    \draw[line width=\plan@wallthickness, \plan@wallcolor, line cap=rect]
      (#2) -- (#3);%
  \fi
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\planwallpath}
% Draws a multi-segment wall path with mitered corners.
%    \begin{macrocode}
\define@key{planwallpath}{thickness}{\setlength{\plan@wallthickness}{#1}}
\define@key{planwallpath}{color}{\def\plan@wallpathcolor{#1}}
\define@key{planwallpath}{closed}{\def\plan@wallpathclosed{#1}}

\newcommand{\planwallpath}[2][]{%
  \begingroup
  \def\plan@wallpathcolor{black}%
  \def\plan@wallpathclosed{false}%
  \setkeys{planwallpath}{#1}%
  \def\plan@tmp@closedtrue{true}%
  \ifx\plan@wallpathclosed\plan@tmp@closedtrue
    \draw[\plan@wallpathcolor, double=\plan@wallpathcolor, double distance=\plan@wallthickness,
          line width=0.4pt, line join=miter, line cap=rect]
      #2 -- cycle;%
  \else
    \draw[\plan@wallpathcolor, double=\plan@wallpathcolor, double distance=\plan@wallthickness,
          line width=0.4pt, line join=miter, line cap=rect]
      #2;%
  \fi
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\planroom}
% Fills a polygon and places a centroid label.
%    \begin{macrocode}
\define@key{planroom}{fill}{\def\plan@roomfill{#1}}
\define@key{planroom}{opacity}{\def\plan@roomopacity{#1}}

\newcommand{\planroom}[3][]{%
  \begingroup
  \def\plan@roomfill{gray!5}%
  \def\plan@roomopacity{0.5}%
  \setkeys{planroom}{#1}%
  \fill[\plan@roomfill, opacity=\plan@roomopacity] #3 -- cycle;%
  \path #3 -- cycle;%
  \node[font=\footnotesize, text=black, opacity=1] at (barycentric cs:#3) {#2};%
  \endgroup
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\planlabel}
% Places a room label at given coordinates.
%    \begin{macrocode}
\newcommand{\planlabel}[2]{%
  \node[font=\footnotesize] at (#1) {#2};%
}
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\plandoor}
% Draws a door leaf with quarter-circle swing arc.
%    \begin{macrocode}
\define@key{plandoor}{width}{\def\plan@doorw{#1}}
\define@key{plandoor}{hinge}{\def\plan@doorhinge{#1}}
\define@key{plandoor}{color}{\def\plan@doorcolor{#1}}
\define@key{plandoor}{opening}{\def\plan@dooropening{#1}}

\newcommand{\plandoor}[3][]{%
  \begingroup
